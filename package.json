{
  "name": "obs-moderator-overlay",
  "version": "1.0.0",
  "private": false,
  "author": "OBS Moderator Overlay contributors",
  "description": "Remote moderator-controlled overlay for OBS Studio via Browser Source",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/free-dev-ports.mjs",
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite --host --strictPort --port 5173",
    "free-ports": "node scripts/free-dev-ports.mjs",
    "build": "vite build",
    "verify:packaged": "node scripts/verify-packaged.mjs",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "serve": "npm run build && npm start",
    "relay": "node relay/server.js",
    "test:relay": "npm --prefix relay run test:e2e",
    "electron:dev": "npm run build && electron .",
    "electron": "electron .",
    "electron:remote": "electron . --mode=remote",
    "electron:host-obs": "cross-env OMO_MODE=host-obs electron . --mode=host-obs",
    "obs-plugin:install": "obs-omo-connector\\install-plugin.bat",
    "dist": "npm run build && electron-builder --win nsis portable",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:nsis": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "multer": "^2.0.1",
    "obs-websocket-js": "^5.0.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@lucide/vue": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "pinia": "^2.2.4",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^5.4.9",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@43.1.0": true
  },
  "build": {
    "appId": "com.aptix.obs-overlay",
    "productName": "OBS Moderator Overlay",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "electron/**/*",
      "package.json",
      "!server/jeetbot-voices-scraped.json",
      "!server/jeetbot-voices-raw.txt",
      "!**/scripts/scrape-*.mjs",
      "!**/.env",
      "!**/.env.*",
      "!**/release/**",
      "!**/debug-*.log",
      "!**/*.md",
      "!**/node_modules/@lucide/**",
      "!**/node_modules/reka-ui/**",
      "!**/node_modules/@vueuse/**",
      "!**/node_modules/class-variance-authority/**",
      "!**/node_modules/clsx/**",
      "!**/node_modules/tailwind-merge/**",
      "!**/node_modules/vue/**",
      "!**/node_modules/vue-router/**",
      "!**/node_modules/pinia/**",
      "!**/node_modules/vite/**",
      "!**/node_modules/@vitejs/**",
      "!**/node_modules/tailwindcss/**",
      "!**/node_modules/@tailwindcss/**",
      "!**/node_modules/tw-animate-css/**",
      "!**/node_modules/electron/**",
      "!**/node_modules/electron-builder/**",
      "!**/node_modules/app-builder-bin/**",
      "!**/node_modules/concurrently/**",
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.ico",
          "icon.png"
        ]
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "*.md"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "build/portable-seed/data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/portable-seed/uploads",
        "to": "uploads",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/omo-plugin-pack/omo-connector",
        "to": "omo-plugin/omo-connector",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "shared/build-info.json",
        "to": "build-info.json"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OBS Overlay",
      "artifactName": "OBS-Moderator-Overlay-Setup-${version}.exe",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": true,
      "warningsAsErrors": false
    },
    "portable": {
      "artifactName": "OBS-Overlay-Portable-${version}.exe",
      "unpackDirName": "OBS-Overlay-Portable"
    }
  }
}
