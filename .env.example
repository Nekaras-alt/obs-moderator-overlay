# Copy to `.env` in the project root (gitignored). Never commit real secrets.
# See docs/CREDENTIALS.md for full setup.

PORT=8090

# DonationAlerts OAuth (optional)
# DA_CLIENT_ID=
# DA_CLIENT_SECRET=
# DA_REDIRECT_URI=http://localhost:8090/api/donations/oauth/da/callback

# Twitch Device Code OAuth (optional)
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI=https://localhost

# Donatex.GG SignalR (optional)
# DONATEX_API_TOKEN=
# DONATEX_WIDGET_URL=
# DONATEX_AI_WIDGET_URL=
# DONATEX_HUB_URL=https://donatex.gg/api/controls-hub

# OBS WebSocket (optional; empty password if auth disabled in OBS)
OBS_HOST=localhost:4455
OBS_PASSWORD=

# Remote connector relay (optional, comma-separated)
# OMO_RELAY_URLS=wss://relay.example/connector
